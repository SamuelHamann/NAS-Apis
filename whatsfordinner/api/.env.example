# whatsfordinner API — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) for local development and fill in real
# values. In production set these as real environment variables instead.
#
# `.env` is also read automatically by Docker Compose, which uses
# WFD_DB_PASSWORD and WFD_BIND_PORT for variable substitution in compose.yaml.

# --- HTTP server ---
WFD_HOST=
WFD_PORT=8080
WFD_READ_TIMEOUT=5s
WFD_WRITE_TIMEOUT=10s
WFD_IDLE_TIMEOUT=120s

# --- Database (application connection) ---
# Preferred: a single connection string (DATABASE_URL). It takes precedence
# over the discrete WFD_DB_* settings below.
#
#   On the NAS (same docker network as the shared postgres stack):
#     postgres://whatsfordinner:PASSWORD@postgres:5432/whatsfordinner
#
#   Local development (postgres bound to loopback on 5433, see
#   NAS-Images/postgres/.env.example -> POSTGRES_BIND_PORT):
#     postgres://whatsfordinner:PASSWORD@localhost:5433/whatsfordinner?sslmode=disable
DATABASE_URL=postgres://whatsfordinner:change-me-whatsfordinner@localhost:5433/whatsfordinner?sslmode=disable

# Discrete fallback — only used when DATABASE_URL is empty.
# WFD_DB_HOST=localhost
# WFD_DB_PORT=5433
# WFD_DB_USER=whatsfordinner
# WFD_DB_PASSWORD=change-me-whatsfordinner
# WFD_DB_NAME=whatsfordinner
# WFD_DB_SSLMODE=disable

# Connection pool / timeouts.
WFD_DB_MAX_CONNS=10
WFD_DB_CONN_TIMEOUT=10s

# --- Gemini (receipt scanning, GET/POST /scan-receipt) ---
# Get a key at https://aistudio.google.com/apikey. Without one, "Scan
# receipt" renders normally but every scan fails with an error banner.
WFD_GEMINI_API_KEY=
WFD_GEMINI_MODEL=gemini-3.1-flash-lite

# --- Pending pantry item queue worker (internal/worker) ---
# Claims a batch of pending_pantry_items every interval and resolves each one
# by UPC against OpenFoodFacts' live API directly (no API key/library
# needed — see internal/worker/pending_pantry_items.go). Defaults stay
# comfortably under OpenFoodFacts' 15 requests/minute limit (13 every
# 1m30s, ~8.7/min).
WFD_QUEUE_WORKER_INTERVAL=1m30s
WFD_QUEUE_WORKER_BATCH_SIZE=13
# Country subdomain queried (https://<locale>.openfoodfacts.org) — "world"
# for the global catalog.
WFD_OPENFOODFACTS_LOCALE=ca

# --- Docker Compose only ---
# Required by compose.yaml — the whatsfordinner role password (must match the
# one in the NAS-Images/postgres stack) and the host loopback port the API
# is published on.
WFD_DB_PASSWORD=change-me-whatsfordinner
WFD_BIND_PORT=8080
