# whatsfordinner frontend — local development configuration.
#
# NOTE: This frontend is a static SPA. There is no build-time secret injection.
# The API base URL and API key are read from `localStorage` at runtime — set
# them from the in-app Settings page (#/settings) the first time you load it.
#
# This file exists only as documentation for the values you'll typically use.

# The whatsfordinner API base URL.
WFD_API_BASE_URL=http://localhost:8080

# A UUID from the API's `api_keys` table — sent as the X-Api-Key header.
WFD_API_KEY=
